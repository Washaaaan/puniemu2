"menu01process_16_04" = "ダウンロード番号を\nぷにっと教えちゃうズラ～。";

"menuitem01process_01_01"   = "Now, let me see... Ahh, yes!";                                             // ええっと…　ここでは;
"menuitem01process_01_02"   = "This is where you can buy\n<R>food</R> and other lovely <R>items</R>!";    // <R>たべもの</R>や<R>どうぐ</R>を\nYマネーで<R>買えます</R>よ！;
"menuitem01process_02_01"   = "Now, let me see... Ahh, yes!";                                             // ええっと…　ここでは;
"menuitem01process_02_02"   = "And you can <R>examine and use</R>\nyour beloved belongings, too!";        // 持っている<R>アイテム</R>を\n<R>確認したり使ったり</R>できますよ！;
"menuitem01process_02_03"   = "Using items is unbelievably\neasy. Just pick the object in\nquestion..."; // アイテムを使う場合は\n使いたいアイテムを選んで;
"menuitem01process_02_04"   = "And tap "Use"!";                                                           // 「つかう」をタップしましょう！;
"menuitem01process_03_01"   = "What's this now...? Ah, these\nare <R>challenges</R>, aren't they?";       // ええっと…　ここでは\nいろいろな<R>お題</R>が出され;
"menuitem01process_03_02"   = "Complete them, and you\ncan earn <R>fabulous rewards</R>!";                // お題をクリアすると\n<R>ほうしゅう</R>がもらえるんです！;
"menuitem01process_03_03"   = "Take a look when you're\nfeeling feisty!";                                 // 気が向いたら　お題を確認して\nクリアしましょう！　うぃす♪;

"menuitem01process_04_01"   = "Fusion lets you <R>mix items and</R>\n<R>Yo-kai to make new ones</R>!";    // 合成は<R>アイテムや妖怪を組合わせ</R>\n<R>新しい妖怪を生み出す</R>んです！;
"menuitem01process_04_02"   = "But remember - <R>you'll lose</R>\n<R>the items and Yo-kai you fuse</R>!"; // 合成に使ったアイテムや妖怪は\n<R>なくなってしまう</R>ので注意です！;

"menuitem01process_05_01"   = "Yo-kai that you befriend will\nbe saved in your <R>Medallium</R>.";        // ともだちになった妖怪は\nこの<R>妖怪大辞典</R>に<R>登録</R>されます！;
"menuitem01process_05_02"   = "There are some <R>sealed pages</R>\nin here, too.";    // 中には<R>封印ページ</R>もあるので;
"menuitem01process_05_03"   = "I wonder what <R>marvelous</R>\n<R>mysteries</R> they hide...";            // 封印を解くと\n<R>何かがおきる</R>かもしれませんよ？;

"menuitem01process_06_01"   = "Map-jumping allows you to <R>zip</R>\n<R>about instantly</R> between areas."; // ワープは<R>マップからマップへ</R>\nかんたんに<R>移動</R>ができるんです！;
"menuitem01process_06_02"   = "And there's also an odd area\nthat can only be jumped to.";                  // たまにそのときだけ\nいけるマップがあるようなので;
"menuitem01process_06_03"   = "Be sure to head straight\nthere when one appears!";                           // 見つけたら行ってみましょう！;

"menuitem01process_07_01"   = "Here you can see your playing\nrecords!";                                  // ここでは　これまで遊んだ\n<R>きろく</R>を見れるんです！;
"menuitem01process_07_02"   = "Use them to help you improve\nyour all-round performance!";                // もっとうまくなれるヒントが\nあるかもしれないですね！;

"menuitem01process_08_01"   = "Come here if you want to\n<R>request a Yo-kai Medal</R>.";             // ここでは　なんと<R>妖怪メダル</R>の\n<R>応募</R>ができちゃうんです！;
"menuitem01process_08_02"   = "It's a <R>surefire chance for some\nfreebies</R>, so don't miss out!"; // <R>無料で</R>しかも<R>確実</R>にもらえるので\nぜひ応募しましょう！　うぃす♪;

"menuitem01process_09_01"   = "Now, this is... Ahh, yes!\n%s!";                                         // ええっと…ここでは\n%sの;
"menuitem01process_09_02"   = "You can change your <R>icon</R>\nand your <R>title</R> here!";           // <R>アイコン</R>や<R>よばれかた</R>を\n変更できますよ！;
"menuitem01process_09_03"   = "You'll earn more icons\nand titles as you play.";                        // アイコンやよばれかたは\n後で増えることがあるので;
"menuitem01process_09_04"   = "See if you can't amass a\na boastful collection!";                       // どんどん集めちゃいましょう！！;

"menuitem01process_10_01"   = "Now, what do we have here...?";                                                                 // ええっと…\nここでは;
"menuitem01process_10_02"   = "Ah, it's where you can <R>find\nfriends who are also playing\nYo-kai Watch Wibble Wobble</R>!"; // 妖怪ウォッチ　ぷにぷにを\n遊んでいる<R>ともだち</R>を<R>検索</R>したり;
"menuitem01process_10_03"   = "You can <R>invite friends</R>\nto play, too!";                                              // まだ遊んでいない<R>ともだち</R>を\n<R>招待</R>したりできますよ！;

"menuitem01process_12_01"   = "This is where you can see all\nthe <R>Yo-kai you've befriended</R>.";     // ええっと…　そうそう。\nここでは　てもちの<R>妖怪の確認</R>と;
"menuitem01process_12_02"   = "And you can <R>swap around</R> the\n<R>ones you use in battle</R>, too."; // パズルで使う<R>妖怪の入れ替え</R>が\nできるんです！;
"menuitem01process_12_03"   = "Why not try making <R>Jibanyan</R>\none of your chosen few?";             // <R>ジバニャン</R>をパズルで使う妖怪に\n入れてみましょう！;
"menuitem01process_12_04"   = "All you need to do is\n<R>drag him into place</R>!";                      // ジバニャンをタッチして\n<R>上の方へもっていく</R>のです。;

"menuitem01process_13_01"   = "Using Yo-kai of the same tribe\nwill have <R>certain special\neffects</R>!"; // 同じ種族の妖怪がセットされて\n<R>しゅぞくこうか</R>がつきましたね！;
"menuitem01process_13_02"   = "These should give your\nteam a little extra oomph!";                         // しゅぞくこうかで　妖怪が\nパワーアップするので;
"menuitem01process_13_03"   = "Good to know when there are\ntwo Yo-kai you can't choose\nbetween!";         // 同じくらいの強さの妖怪であれば\n種族をそろえるといいですよ！！;

"menuitem01process_14_01"   = "Now, this is... Umm... It's...";                                         // ええっと…\nそうそう。　ここでは;
"menuitem01process_14_02"   = "Yes, the <R>Crank-a-kai</R>! It takes\nY-money and special coins!";      // Yマネーかガシャコインを使って\n<R>妖怪ガシャ</R>をまわせるんです！;
"menuitem01process_14_03"   = "What do you get when you crank\nit? Only one way to find out!";          // どんなものがでてくるのか\nまわしてみてのお楽しみです！;
"menuitem01process_14_04"   = "Pop that coin you got in,\nand give it a whirl!";                        // さっきゲットしたコインを使って\n早速まわしてみましょう！;
"menuitem01process_15_01"   = "Beating bosses can earn you\nextremely special coins.";                  // ボス的な妖怪を倒すと;
"menuitem01process_15_02"   = "These <R>5-star</R> beauties will\ncrank out nothing but rare\nYo-kai!"; // レアな妖怪だけが出てくる\n<R>5つ星コイン</R>がもらえるので;
"menuitem01process_15_03"   = "So do your best to beat the\nboss up ahead and earn one!";               // この先にいるボス的な妖怪を\n倒しに行きましょう！;

"menuitem01process_16_01"   = "Let's see now... Ah, this is\nwhere you can keep your\n<R>Yo-kai medals</R>!"; // えーと　ここでは<R>妖怪メダル</R>を\n登録することができるんです！;
"menuitem01process_16_02"   = "And the more you collect,\nthe more amazing things will\nhappen!";              // 登録すると色々と\nよいことがあるみたいなので;
"menuitem01process_16_03"   = "So collect as many as you can!";                                               // 妖怪メダルをたくさん\n登録するでうぃす♪;

"menuitem01process_17_01" = ""; // えーと…　ここでは\n妖怪ウォッチ３で使える;
"menuitem01process_17_02" = ""; // ダウンロード番号を\nかくにんできますよ！;
"menuitem01process_17_03" = ""; // 妖怪ウォッチ３でも;
"menuitem01process_17_04" = ""; // ぷにニャン　と　ぷにコマを\nおともだちにするでうぃっす♪;

"othertutorials_01_01"		= "Amaaaaaaaaaazing!\nYou're an all-star!";                               // すごいですね！\n☆をゲットしましたね。;
"othertutorials_01_02"		= "You earn these by\naccomplishing <R>stage-specific\nachievements</R>.";        // ☆は各ステージに設定された\n<R>条件を達成</R>するともらえますよ！;
"othertutorials_01_03"		= "To find out what they are,\njust <R>tap a star and see</R>!";                  // ☆の条件は<R>☆をタップ</R>すると\n確認できるんです♪;
"othertutorials_01_04"		= "Stars make good things happen,\nso be sure to collect them!";                  // ☆を集めるといいことがあるので\nどんどん集めましょう！！;
"othertutorials_02_01"		= "You've found your way to\na <R>hidden stage</R> I see!";                       // かくしステージへ\n行けるようになりましたね！;
"othertutorials_02_02"		= "These are uncovered when\nyou accomplish certain\nachievements!";                       // <R>かくしステージ</R>は何か条件を\n満たすと行けるようになります！;
"othertutorials_02_03"		= "They're <R>tough</R> though,\nso don't be afraid to\nleave them for later!";    // かくしステージの<R>敵は強い</R>ので\n倒せなかったら後にしましょう！;
"othertutorials_03_01"		= "I see one of your Yo-kai's\n<R>S-Move Level</R> has increased!";               // 妖怪の<R>わざレベル</R>が\n上がりましたね！;
"othertutorials_03_02"		= "That happens when you <R>befriend</R>\n<R>the same Yo-kai twice</R>!";         // <R>同じ妖怪</R>と再びともだちになると\nわざレベルがアップするんです！;
"othertutorials_03_03"		= "Higher S-Move Levels will give\nyou a distinct advantage.";                     // わざレベルがアップすると\nパズルが断然有利になるので;
"othertutorials_03_04"		= "So be sure to seek out\nlots of the same Yo-kai!";                             // 積極的に同じ妖怪と\nともだちになりましょう♪;
"othertutorials_03_05"		= "You can also increase S-Move\nLevels with items called\n<R>Soul Secrets</R>!"; // アイテムの<R>ひっさつの秘伝書</R>でも\nわざレベルは上げられますよ！;
"othertutorials_03_06"		= "You can get them at the\n<R>Crank-a-kai</R> and elsewhere!";                   // ひっさつの秘伝書は<R>妖怪ガシャ</R>\nなどで入手できるでうぃっす♪;

"othertutorials_04_01"		= "There's something...different\nabout these pages...";                          // ここのページは\nほかと雰囲気が違いますね…;
"othertutorials_04_02"		= "Something's sealed inside...\nSomething...<R>legendary</R>...";                // <R>レジェンド</R>的な何かが\n封印されているようですよ！;
"othertutorials_04_03"		= "And the <R>key</R> to freeing it lies\nwith a certain six Yo-kai!";            // <R>封印</R>をとくカギは\n6匹の妖怪です！;
"othertutorials_04_04"		= "Tap to find out more about\neach of them!";                                    // 6ヶ所をタップして\n妖怪を確認しましょう！;

"othertutorials_05_01"		= "It's locked!\nWe can't go any further!";                                       // ロックを<R>解除</R>しないと\nこの先に進めないようですね…;
"othertutorials_05_02"		= "As far as I know, there are\nthree ways to unlock it...";                      // ロックの解除方法は3つあって\nどれか1つで解除できますよ！;
"othertutorials_05_03"		= "You can spend some <R>Y-Money</R>...";                                         // <R>Yマネー</R>で解除するか;
"othertutorials_05_04"		= "You can have your real-life\nfriends send you\n<R>Friend Points</R>...";       // 人間のおともだちに<R>ともだち</R>\n<R>ポイント</R>を送ってもらうか;
"othertutorials_05_05"		= "Or you can <R>level up the Yo-kai</R>\nto the levels required!";               // 指定された<R>妖怪</R>を指定された\nレベルまで育てるか　です！;

"othertutorials_06_01"		= "Wh-Wh-Wh-!\nGoodness gracious me!";                                                    // おや これはまさか！？\nなっなっなんと！！;
"othertutorials_06_02"		= "Apparently, it's easier than\nnormal to befriend <R>%s</R>\nright now!";                // <R>%s</R>がともだちに\n<R>なりやすくなる</R>という;
"othertutorials_06_03"		= "This is a <R>rare and</R>\n<R>exciting occurrence</R>!";                               // とっても<R>めずらしい時間</R>\nらしいですよ！！;
"othertutorials_06_04"		= "And it <R>won't last long</R>,\nso make the most of it!";                              // 時間は<R>かぎられている</R>ので\n<R>注意</R>してくださいね！;

"othertutorials_07_01"		= "The <R>rankings</R> tell you\nwho's the best of the best\nof the best!";                // えーと…　ここはスコアなどを\n競う<R>ランキング</R>でうぃっす♪;
"othertutorials_07_02"		= "The <R>Score Attack</R> rankings\nare updated every Monday.";                          // <R>スコアアタック</R>のランキングは\n次の月曜まで競うものです！;
"othertutorials_07_03"		= "And the highest scorers win\nwonderful wads of <R>Y-Money</R>!";                       // 月曜になると　その時のスコアに\n応じて<R>Yマネー</R>がもらえますよ！;
"othertutorials_07_04"		= "If a friend makes the\nrankings, the two of you can\n<R>send and receive Spirit</R>."; // ランキングにおともだちがいれば\n<R>ひとだまを送りあえる</R>ので;
"othertutorials_07_05"		= "So be sure to encourage them\nto aim high!";                                           // 周りのおともだちを誘って\n一緒に遊びましょう！;

"othertutorials_07_11"      = "<R>Score Attack</R> Ranking is a\ncompetition held every week!"; // <R>スコアアタック</R>のランキングは\n次の<R>月曜</R>まで競うものです！;
"othertutorials_07_12"      = "Every Monday, you will\nreceive a <R>Reward</R>";                  // 月曜になると　その時の\n<R>スコア</R>や<R>順位</R>によって;
"othertutorials_07_13"      = "based on your <R>Score</R> and <R>Rank</R>.\nGood luck!";                     // <R>ごほうび</R>がもらえるので\nがんばりましょう！！;
"othertutorials_07_14"      = "If your friends are ranked,\nyou can <R>send them Spirit, </R>";    // ランキングにおともだちがいれば\n<R>ひとだまを送りあえる</R>ので;
"othertutorials_07_15"      = "so invite your friends and\nplay together!";                                                      // 周りのおともだちを誘って\n一緒に遊びましょう！;
"othertutorials_07_16"      = "The rules for Score Attack are\n<R>a little different</R>\nfrom regular puzzles,"; // スコアアタックは通常のパズルと\n<R>ルールがちょっと違う</R>のですが;
"othertutorials_07_17"      = "but don't worry about the\ndetails and try it out!";                                                     // 細かいことは気にせず\nとりあえずやっちゃいましょう！;

"othertutorials_13_01"      = "Add medals by scanning their\nQR codes with your camera.";       // <R>カメラ</R>で<R>QRコード</R>を読み取ると\n妖怪メダルを登録できますよ！;
"othertutorials_13_02"      = "Adding a medal will give you\naccess to exclusive Yo-kai\ndata!"; // 登録すると<R>妖怪メダルの情報</R>が\nみれるようになったり;
"othertutorials_13_03"      = "And it will also earn you\nultra-valuable <R>Medal Points</R>!"; // <R>メダルポイント</R>などを\n獲得できますよ！;

"othertutorials_14_01"      = "You can look at your list of\n<R>collected medals</R>...";       // <R>とうろくしたメダル</R>では;
"othertutorials_14_02"      = "To find out all about them!\nA fountain of knowledge\nawaits!";   // 登録された妖怪メダルの情報を\n確認できますよ！;

"othertutorials_15_01"      = "Here, you can spend your\n<R>Medal Points</R> on all kinds of\ngoodies!"; // ここでは　<R>メダルポイント</R>を\n色々なものと<R>交換</R>できますよ！;
"othertutorials_15_02"      = "Some of them are so <R>rare</R>,\nyou can only get them here!";           // ここでしか手に入らない\n<R>レアなもの</R>もあるみたいですよ♪;

"othertutorials_16_01"      = "Here, you can spend your\n<R>Medal Points</R> to battle certain\nYo-kai!"; // ここでは<R>メダルポイント</R>を使って\n<R>妖怪とバトル</R>できますよ！;
"othertutorials_16_02"      = "The Yo-kai you'll face will be\ndifferent every time.";                    // 敵の妖怪は毎回変わり;
"othertutorials_16_03"      = "And there might be the odd\none you won't find anywhere\nelse!";           // ここでしか出会えない\n妖怪もいるかもしれませんよ！;

"othertutorials_17_01"      = "Jolly good show!";                                                         // おめでとうございます〜！;
"othertutorials_17_02"      = "When you add <R>lots of medals</R>,\nor <R>certain special medals</R>..."; // <R>特別なメダル</R>や\n<R>たくさん</R>メダルを登録すると;
"othertutorials_17_03"      = "You can earn some truly\nwonderful rewards!";                              // 豪華なごほうびが\nもらえるみたいです！;
"othertutorials_17_04"      = "So keep\ncollecting!";                                                     // この調子で\nどんどん登録していきましょう！;

