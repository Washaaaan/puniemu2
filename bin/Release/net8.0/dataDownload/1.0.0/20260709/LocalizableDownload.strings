"sangokushi_result_receipt_title01"     = "Ranking Reward"; // ランキング報酬;
"sangokushi_result_receipt_title02"     = "Confirm"; // かくにん;
"sangokushi_result_receipt_desc01"      = "Rewards will be delivered to your Inbox!"; // ごほうびをゆうびんにとどけました！; "Rewards have been delivered to your inbox!";
"sangokushi_result_receipt01"           = "The results are being announced!\nWait until the next match!"; // 結果発表中だよ！\n次の対戦が始まるまで待ってね！; "The results are being announced!\nWait until the next match begins!";
"sangokushi_result_receipt02"           = "The event has ended!\nPlease look forward to\nthe next event!"; // イベントは終了しました！\n次のイベントを楽しみにしててね！; "The event has ended!\nLook forward to the next event!";

"sangokushi_result_receipt_talk01"      = "It's finally here!\nAt last, the <R>Results Announcement</R>!!"; // おまたせいたしました！\nいよいよ　<R>結果発表</R>です！！; "Thanks for waiting!\nIt's time to announce the results!";
"sangokushi_result_receipt_talk02"      = "Let's see here,\nhow did things turn out!?"; // さて　いったい\nどうなったのでしょうか！？; "Now then, let's see\nwhat's happened!?"; 
"sangokushi_result_receipt_talk03"      = "Let's look at\nthe Team Rankings first!"; // まずはチームランキングからの\n発表でうぃす～！; "I'll begin by announcing\nthe results of the team ranking!"; 

"tutorial_sangoku_atk_01"               = "What...!?\nYou're being invaded!"; // なんと…！？\nせめこまれて　しまいましたよ！;
"tutorial_sangoku_atk_02"               = "I don't have a very good\nfeeling about this..."; // ただならぬ妖気を\n感じるでうぃす…;
"tutorial_sangoku_atk_03"               = "There are strong Yo-kai lurking about,\nbut lot's of treasure chests will drop"; // つよい妖怪が出てきますが\n宝箱が　いっぱい出るようなので;
"tutorial_sangoku_atk_04"               = "so do your best and send them packing!"; // がんばって　おい返しましょう！;

"puzzlefuncopendialog_01"   = "It's <R>Fever Time</R>, folks!";                   // <R>フィーバー</R>が開放されました;
"puzzlefuncopendialog_02"   = "It's time to unleash a <R>Soultimate Move</R>!"; // <R>ひっさつわざ</R>が開放されました;

"map01process_01_01"        = "Hey, look! There's a <R>Red Cat\nWib Wob</R> over there!"; // あそこに　さっき逃げていった\n<R>赤い猫の妖怪ぷに</R>がいますね。;
"map01process_01_02"        = "Oh, sorry. This must all sound\nlike gibberish to you..."; // あ！\nそうそう。;
"map01process_01_03"        = "Those wibbly wobbly,\ntimey whimey things - \nthose are called Wib Wobs!"; // あのぷにぷにぷにぷにしたのは\n<R>妖怪ぷに</R>というんです♪;
"map01process_01_04"        = "Let's make our way over to\nwhere the red cat is,\nshall we?"; // 赤い猫の妖怪ぷにのところまで\n行ってみましょう！;

"map01process_02_01"        = "...Hnnnngh! Wait!";                                  // むむっ！;
"map01process_02_02"        = "I'm detecting the presence\nof a Yo-kai nearby!";    // このあたりから\n妖気を感じますよ！;
"map01process_02_03"        = "Get your Yo-kai Watch out\nand investigate!";        // 妖怪ウォッチを使って\n調べてみるのです！　うぃす♪;
"map01process_03_01"        = "I knew it! There's our\nculprit!";                   // やっぱりいましたよ！;
"map01process_03_02"        = "And he's none too happy at\nhaving been disturbed!"; // 寝ているところを起こされて\n怒っているようですね…;
"map01process_03_03"        = "Looks like we'll have to fight\nour way through!";   // ここを突破しないと\n先に進めないようです！;
"map01process_03_04"        = "Ready or not, %s,\nhere he comes!";                  // %s！\n戦いましょう！！;
"map01process_03_05"        = "Oh yeah! You don't have\nany Wib Wobs, do you?";     // でも　戦うのに必要な妖怪ぷにを\n持っていないですね。;
"map01process_03_06"        = "Here, I picked these ones up\na little while ago.";  // さっきひろった\nこれをあげましょう！！;
"map01process_03_07"        = "Whisper gives you a Wib Wob\nstarter pack!";         // 妖怪ぷにセットを\nもらった。;

"map02process_01_01"        = "Hnnngh! I'm sensing a\nseriously strong presence\nnear the school!"; // むむっ…！　小学校の方に\n強い妖気を感じますよ…;
"map02process_01_02"        = "It's a boss Yo-kai, or my\nwisp isn't white!";                       // これはきっと\n<R>ボス的な妖怪</R>に違いありません！;
"map02process_01_03"        = "You'd better befriend plenty\nof Yo-kai before you reach\nhim!";     // ボスにたどり着く間に妖怪を\nどんどん<R>ともだち</R>にしましょう！;

"puzzle01process_01_01"     = "<R>Link up</R> Wib Wobs of the same\nkind to <R>make them bigger</R>!";        // 同じ妖怪ぷにを<R>つなげて</R>\n<R>でっかく</R>したり;
"puzzle01process_01_02"     = "Then <R>tap</R> them to <R>pop</R> them!\nCouldn't be simpler!";               // 妖怪ぷにを<R>タップ</R>して<R>消す</R>\nのが基本操作でうぃっす♪;
"puzzle01process_01_03"     = "Shall I explain how it all\nworks while we're here?";                          // <R>パズルの基本操作</R>を\nご説明しましょうか！？;
"puzzle01process_02"        = "Listen to Whisper's\nexplanation?";                                            // ウィスパーの説明を\n聞きますか？;
"puzzle01process_03"        = "Righty-oh! Now, that Yo-kai at\nthe <R>top</R> is your <R>enemy</R>.";         // うぃす♪\n<R>上</R>にいる妖怪が<R>敵</R>です！;
"puzzle01process_04"        = "And these here are <R>your Yo-kai</R>\nand their HP, or health\npoints!";       // ここは%sの<R>味方の妖怪とHP</R>ですよ！;
"puzzle01process_05_01"     = "To attack the enemy, simply\n<R>pop a Wib Wob by tapping on\nit</R>!";          // 敵を攻撃するには　妖怪ぷにを\n<R>タップして消す</R>のです！;
"puzzle01process_05_02"     = "Go on, give it a try!\nPippity pop!";                                          // さっそく妖怪ぷにを\n消してみましょう♪;
"puzzle01process_06_01"     = "Not bad at all!";                                                               // いいですね！;
"puzzle01process_06_02"     = "Now, let's try and make a\nWib Wob bigger, shall we?";                          // 次は妖怪ぷにを\nでっかくしてみましょう！;
"puzzle01process_06_03"     = "<R>Link up Wib Wobs</R> of the same\nkind to make them <R>grow in\nsize</R>.";  // 同じ妖怪ぷに同士を<R>つなげると</R>\nくっついて<R>でっかくなる</R>んです♪;
"puzzle01process_07_01"     = "My word, %s!\nYou're a natural!";                                               // %s！\nすごいですね！！;
"puzzle01process_07_02"     = "The bigger a Wib Wob is when\nyou pop it, the <R>more damage</R>\nit will do!"; // でかい妖怪ぷにを消すと　敵への\n<R>ダメージもでかい</R>んですよ！;
"puzzle01process_07_03"     = "Why don't you try popping a\nnice big Wib Wob for me?";                         // 今度は　でかい妖怪ぷにを\n消してみましょう！;
"puzzle01process_08_01"     = "Well now, what have we\nhere...?";                                              // 何か出ましたよ！;
"puzzle01process_08_02"     = "Oooh, a <R>Bonus Ball</R>! Lovely!";                                            // えーと…\nこれは<R>ボーナス玉</R>ですよ！;
"puzzle01process_08_03"     = "These appear sometimes after\nyou pop a big Wib Wob!";                          // でかぷにを消した時に\nたまに出現するでうぃっす！;
"puzzle01process_08_04"     = "Tap them to make all the Wib\nWobs around them get bigger!";                    // タップすると　まわりの\n妖怪ぷにを<R>でかく</R>しますよ！;
"puzzle01process_09"        = "Growth: A sure sign of\nprogress! Let's continue,\nshall we?";                   // でかくなりましたね。\nそれではパズルを続けましょう！;

"puzzle02process_00"        = "%s!";                                                             // %s!;
"puzzle02process_01"        = "Next, I'd like to talk to you\nabout enemy attacks.";             // 次は<R>敵の攻撃</R>について\nご説明しましょうか！？;
"puzzle02process_02"        = "Listen to Whisper's\nexplanation?";                               // ウィスパーの説明を\n聞きますか？;
"puzzle02process_03_01"     = "There's a little number next\nto your foe there. ...See it?";     // 敵の横に数字がありますね！;
"puzzle02process_03_02"     = "That's the countdown until\nthe enemy's next attack.";            // この数字は敵が攻撃してくる\nまでのカウントなんです！;
"puzzle02process_03_03"     = "As time passes,\nit ticks on down...\nTick-tock... Tick-tock..."; // 時間が経つとカウントがへり;
"puzzle02process_03_04"     = "And when it reaches zero...\nBlammo, whammo, Kablooey!";          // カウントが０になると\n敵が攻撃をしてきますよ！;
"puzzle02process_03_05"     = "Keep your eye on it, and\nlet's carry on, shall we?";             // それでは気をつけて\n戦いましょう！;
"puzzle02process_04_01"     = "Hmm... Your HP's looking\nrather low, %s...";                     // %sたちの\nHPが減りましたね…;
"puzzle02process_04_02"     = "If it reaches zero, it's\ngame over. No pressure.";               // HPが0になると<R>ゲームオーバー</R>\nなので注意しましょう！;
"puzzle02process_04_03"     = "Now, keep going and try not\nto get clobbered!";                  // それでは敵にやられないよう\nにしてパズルを続けましょう♪;

"puzzle03process_01"        = "It's time to have a little\ntalk about <R>Fever Mode</R>!";               // 今度は<R>フィーバー</R>について\nご説明しましょうか！？;
"puzzle03process_02"        = "Listen to Whisper's\nexplanation?";                                       // ウィスパーの説明を\n聞きますか？;
"puzzle03process_03_01"     = "Giggling!!!";                                                             // うぃす♪;
"puzzle03process_03_02"     = "This bar down at the bottom of\nthe screen is your <R>Fever\nGauge</R>."; // 画面下のこのゲージは\n<R>フィーバーゲージ</R>というんです！;
"puzzle03process_03_03"     = "The more Wib Wobs you link\ntogether, the more the gauge\nfills up.";      // 妖怪ぷにをつなげると\nゲージがたまるんでうぃっす！;
"puzzle03process_03_04"     = "Just this once, I've made it\nfill up extra fast.";                       // 今回はとくべつに\nゲージがたまりやすいので;
"puzzle03process_03_05"     = "Go ahead - fill 'er up!\nTake me to Fever Town!";                         // さっそく\nフィーバーしてみましょう！！;
"puzzle03process_04_01"     = "Iiiit's...<R>FEVER TIIIIIIME</R>!!!";                                         // <R>フィーバー</R>になりましたよ！！;
"puzzle03process_04_02"     = "And that means the enemy\n<R>can't attack you</R>!";                          // フィーバー中は\n<R>敵が攻撃できなく</R>なり;
"puzzle03process_04_03"     = "Not only that, but your\n<R>attacks grow extra-strong</R> too!";              // %sたちの\n<R>攻撃は強くなる</R>ので;
"puzzle03process_04_04"     = "Now's your chance!\nShow no mercy!";                                          // <R>大チャンス</R>ですよ！！;
"puzzle03process_04_05"     = "Any Wib Wobs you pop in Fever\nMode won't deal damage right\naway.";          // フィーバー中に妖怪ぷにを消すと\nすぐにダメージをあたえず;
"puzzle03process_04_06"     = "Instead, <R>you'll deal all that\ndamage at once when Fever Mode\nends</R>!"; // フィーバーが<R>終わったとき</R>に\nまとめて<R>でっかく攻撃</R>しますよ！;
"puzzle03process_04_07"     = "Here it comes! <R>Ten seconds</R> of\nFever Mode! Pop those Wib\nWobs!";       // それでは<R>10秒間</R>のフィーバー\nはじまりでうぃっす♪;

"puzzle04process_00"        = "%s!";                                                                                   // %s！;
"puzzle04process_01"        = "Want to hear about how you\ncan make enemy Yo-kai your\nfriends?";                      // 敵の妖怪が<R>ともだちになる</R>ことが\nあるんですが興味はありますか？;
"puzzle04process_02"        = "Listen to Whisper's\nexplanation?";                                                     // ウィスパーの説明を\n聞きますか？;
"puzzle04process_03_01"     = "Sometimes, Yo-kai you beat\nin battle will want to be your\npals.";                     // 敵の妖怪を倒すと　ともだちに\nなることがあるんです！;
"puzzle04process_03_02"     = "And giving them <R>treats they\nlike</R> will increase the odds\nof befriending them."; // <R>好物</R>をあげるとなつきやすくなる\nのであげてみましょう♪;
"puzzle04process_04_01"     = "Delicious!";                                                                            // うまく好物をあげられましたね♪;
"puzzle04process_04_02"     = "Let's finish this fight and\nsee if we've made a new\nfriend!";                         // ともだちになってくれることを\n願って倒しちゃいましょう！！;
"puzzle04process_05_01"     = "Yippadeedoodaa!\nA new friend!";                                                        // ともだちになってくれましたね！;
"puzzle04process_05_02"     = "The first of many, I hope!\nKeep up the good work!";                                    // この調子でともだち妖怪を\n増やしていきましょう！;

"puzzle05process_00"        = "%s!";                                                                              // %s！;
"puzzle05process_01"        = "In this last lesson, we're\ngoing to learn about\n<R>Soultimate Moves</R>.";       // 最後に<R>ひっさつわざ</R>について\n説明しますよ！！;
"puzzle05process_02"        = "Listen to Whisper's\nexplanation?";                                                // ウィスパーの説明を\n聞きますか？;
"puzzle05process_03_01"     = "Each of your Yo-kai friends\nhas an <R>extra-special secret\nmove</R>.";            // ともだち妖怪はそれぞれ<R>ひっさつ</R>\n<R>わざ</R>を持っているんです！;
"puzzle05process_03_02"     = "When you pop a Wib Wob, that\nYo-kai's S-Move Gauge will\nslowly fill up.";          // 妖怪ぷにを消すと消した妖怪の\nわざゲージがたまり;
"puzzle05process_03_03"     = "And when it's full, you can\nunleash their Soultimate Move!";                      // <R>わざゲージが満たん</R>になったら\nひっさつわざをつかえますよ！;
"puzzle05process_03_04"     = "Alright, let's pop those Wib\nWobs and fill that gauge!";                          // それでは妖怪ぷにを消して\nわざゲージをためてみましょう！;
"puzzle05process_04_01"     = "Look! Loooooook! Those Wib\nWobs are itching for action!";                         // 見てください！\n妖怪ぷにがやる気まんまんです！;
"puzzle05process_04_02"     = "Well, what are you waiting\nfor? Unleash that <R>Soultimate\nMove</R>!";           // さぁ　<R>ひっさつわざ</R>を\n使ってみるのです！！;
"puzzle05process_05_01"     = "You've come a long way,\n%s!\nYou're welcome, by the way.";                         // %s！\nかなり上達しましたね！;
"puzzle05process_05_02"     = "I think it's time to teach you\na little technique only the\npros know!";          // ちょっと上級者向けの\nテクニックも教えちゃいますよ！;
"puzzle05process_05_03"     = "2 or more Wib Wobs popped\nwithin 3 seconds starts a\ncombo.";                     // 2つ以上つなげた妖怪ぷにを3秒\n以内に消し続けると<R>コンボ</R>です！;
"puzzle05process_05_04"     = "Not only do combos increase\nthe amount of damage you do...";                      // コンボが続くと敵へのダメージが\nちょっとだけ増えて;
"puzzle05process_05_05"     = "They also boost your score!\nReach for the stars, kid!";                           // スコアが上がるのでハイスコアを\n目指すとき狙ってみましょう！;

"menu01process_01_01"       = "Jibanyan";                                                              // ジバニャン;
"menu01process_01_02"       = "I'm here to teach you how to\nswap your Wib Wobs around!";              // オレっちが妖怪を代表して　妖怪\nぷにの入れ替えをするニャン！;
"menu01process_02_01"       = "Shmoopie";                                                              // キュン太郎;
"menu01process_02_02"       = "Oooh, I just can't wait to try\nthe Crank-a-kai!\nI looove surprises!"; // ボク　妖怪ガシャを\nやってみたいキュン〜！;
"menu01process_02_03"       = "Turning that wheel makes my\nheart Wibble Wobble!";               // ガシャまわすときって\nキュンキュンしちゃうキュン〜！;
"menu01process_03_01"       = "Spenp";                                                                 // ムダヅカイ;
"menu01process_03_02"       = "Don't worry about Y-Money for now!";                                    // やあ！　とりあえず\nYマネーは気にしないで;
"menu01process_03_03"       = "Let's go shoppiiiiiing!";                                               // パーッと買い物に行こうよ！;
"menu01process_04_01"       = "Hungramps";                                                             // ひも爺;
"menu01process_04_02"       = "Sooo huuuungry...";                                                          // ひもじいのぉ～。;
"menu01process_04_03"       = "What I wouldn't do for a rice ball...";                                 // おにぎりを\nめぐんでくれんかのぉ〜。;
"menu01process_05_01"       = "Sgt. Burly";                                                            // ブリー隊長;
"menu01process_05_02"       = "You need some exercise,\nsoldier!";                                     // 体がなまって\nいるんじゃないのか？;
"menu01process_05_03"       = "Time to take on a <R>mission</R> or\ntwo!";                             // <R>ミッション</R>でエクササイズだ！;
"menu01process_05_04"       = "The rewards are worth the\npain! Go check 'em out!";                    // ミッションは<R>ほうしゅう</R>が\nあるから必ずチェックするんだ！;
"menu01process_06_01"       = "Manjimutt";                                                             // じんめん犬;
"menu01process_06_02"       = "I'm a doggone fusion of man\nand mutt! ...You done any\nfusing yourself yet?"; // 私は人間と犬の合成なんですよ。\nあなたも合成いかがですか？;
"menu01process_07_01"       = "Mirapo";                                                                // うんがい鏡;
"menu01process_07_02"       = "Blehhh... I can join\nmirrors together, you know!";                     // ぺろ～ん。\n鏡の中の空間をつなぐことで;
"menu01process_07_03"       = "Come see me if you want to\ntravel a long way in a\nshort time!";       // どこへでも行けるので遠出の際は\nわたくしをご利用ください。;
"menu01process_08_01"       = "Flushback";                                                             // おもいだスッポン;
"menu01process_08_02"       = "If you make a record of your\nmemories, you'll never forget\nthem!";     // あとで思い出せるように\n記録を残しておくのじゃ！;
"menu01process_09_01"       = "Orcanos";                                                               // 黒鬼;
"menu01process_09_02"       = "You're a tough one! Here, have\nmy medal! You deserve it!";             // お前は強い！　ほうびにワシの\n妖怪メダルを送ってやるぞ！;
"menu01process_10_01"       = "Hey, look! There's a new\noption on the menu!";                         // おや　メニューに新しい機能が\n追加されたみたいですね！？;
"menu01process_11"          = "The "<R>%s</R>" option\nhas been added to the menu!";                   // <R>%s</R>が\nメニューに追加された！;

"menu01process_12_01"       = "You made friends with\n%s!"; // %sとともだちに\nなったおかげでメニューに;
"menu01process_12_02"       = "You made friends with\n%s!"; // %sとともだちになった\nおかげでメニューに;
"menu01process_13"          = "The "<R>%s</R>" option\nhas been added to the menu!"; // <R>%s</R>が追加されましたよ！\n早速使ってみましょう！;
"menu01process_14"          = "The "<R>%s</R>" option\nhas been added to the menu!"; // <R>%s</R>が追加されましたよ！\n早速使ってみましょうか！？;
"menu01process_15"          = "Check out the instructions\nfor the new menu option?"; // 追加されたメニューの\nチュートリアルを行いますか？;

